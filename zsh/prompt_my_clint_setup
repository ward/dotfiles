# Local copy of the clint prompt theme
# Compare: /usr/share/zsh/5.9/functions/prompt_clint_setup
# Useful info <https://zsh.sourceforge.io/Doc/Release/Prompt-Expansion.html>, though doesn't seem to include git stuff?

prompt_my_clint_help () {
  cat <<'EOF'

  prompt my_clint [<color1> [<color2> [<color3> [<color4> [<color5>]]]]]

  defaults are red, cyan, green, yellow, and white, respectively.

EOF
}

prompt_my_clint_setup () {
  local -a pcc
  local -A pc
  local p_date p_tty p_plat p_ver p_userpwd p_apm p_shlvlhist p_rc p_end p_win

  autoload -Uz vcs_info

  pcc[1]=${1:-${${SSH_CLIENT+'yellow'}:-'red'}}
  pcc[2]=${2:-246} # 246 is a grey
  pcc[3]=${3:-'green'}
  pcc[4]=${4:-'yellow'}
  pcc[5]=${5:-'white'}

  pc['\[']="%F{$pcc[1]}["
  pc['\]']="%F{$pcc[1]}]"
  pc['<']="%F{$pcc[1]}<"
  pc['>']="%F{$pcc[1]}>"
  pc['\(']="%F{$pcc[1]}("
  pc['\)']="%F{$pcc[1]})"

  # p_date="$pc['\[']%F{$pcc[2]}%2>>%D{%a}%<< %D{%Y-%m-%d %H:%M}$pc['\]']"
  p_date="%F{$pcc[2]}%2>>%D{%a}%<< %D{%Y-%m-%d %H:%M}"
  p_tty="$pc['\[']%F{$pcc[3]}%l$pc['\]']"
  p_plat="$pc['\[']%F{$pcc[2]}${MACHTYPE}/${OSTYPE}/$(uname -r)$pc['\]']"
  p_ver="$pc['\[']%F{$pcc[2]}${ZSH_VERSION}$pc['\]']"

  [[ -n "$WINDOW" ]] && p_win="$pc['\(']%F{$pcc[4]}$WINDOW$pc['\)']"

  # p_userpwd="$pc['<']%F{$pcc[3]}%n@%m$p_win%F{$pcc[5]}:%F{$pcc[4]}%~$pc['>']"
  p_userpwd="%F{$pcc[3]}%n@%m$p_win%F{$pcc[5]}%f · %F{$pcc[4]}%~"
  # Version control from vcs_info through psvar (see precmd hook)
  local p_vcs="%f%(2v.%2v .)"

  # zsh or if nested shell: zsh/N. Followed by history event number
  p_shlvlhist="%fzsh%(2L./$SHLVL.) %B%h%b "
  # Shell return exit code if error
  p_rc="%(?..[%?%1v] )"
  # $ sign (or # for root)
  p_end="%f%B%(#.#.$)%b "

  typeset -ga zle_highlight
  zle_highlight[(r)default:*]=default:$pcc[2]

  # Trimmed out several entries from the original
  prompt="$p_date%f · $p_userpwd
$p_rc$p_vcs$p_end"
  PS2='%(4_.\.)%3_> %E'

  add-zsh-hook precmd prompt_my_clint_precmd
}

# precmd hook, runs before each prompt
prompt_my_clint_precmd () {
  setopt noxtrace noksharrays localoptions
  local exitstatus=$?
  local git_dir git_ref

  psvar=()
  [[ $exitstatus -ge 128 ]] && psvar[1]=" $signals[$exitstatus-127]" ||
	psvar[1]=""

  [[ -o interactive ]] && jobs -l

  # Gets version control info (e.g. Git). If a value is found, add it on index
  # 2 in the prompt array psvar. Then within the prompt, the magic string %2v
  # gets the second element of this array.
  # See `man zshcontrib`, go to vcs_info section, to learn more about
  # formatting of it.
  vcs_info
  [[ -n $vcs_info_msg_0_ ]] && psvar[2]="$vcs_info_msg_0_"
}

prompt_my_clint_setup "$@"
