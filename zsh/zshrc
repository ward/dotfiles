export EDITOR=nvim

# Aliases
alias l='ls -lh --color=auto -F'
alias ll='ls -alh --color=auto -F'
alias cdgit='cd $(git rev-parse --show-toplevel)'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ,pprint-path='echo "${PATH//:/\n}"'
alias ,shuf="perl -MList::Util=shuffle -e 'print shuffle(<STDIN>);'"
# Does not seem to work any more
# alias myip="dig +short myip.opendns.com @resolver1.opendns.com"
function ,clock() {
  while true
  do
    echo -ne "`date`\r"
    sleep 0.2
  done
}
function ,countdown() {
  sleep $1
  osascript -e "display notification \"$3\" with title \"$2\""
}

# Can also fast forward from local branch with git fetch . srcbranch:dstbranch
alias ,git-update-develop='git fetch origin develop:develop'
alias ,git-tag='git tag --list -n1 | sort -V'

case $(uname) in
  Linux)
    alias open='xdg-open'
    alias pbcopy='xclip -selection clipboard'
    alias pbpaste='xclip -selection clipboard -o'
    ;;
  Darwin)
    # Nothing at the moment
    ;;
esac

export PATH="/Users/ward/.local/bin:$PATH"

# FZF setting up
if [ -x "$(command -v fzf)" ]; then
  # Set up fzf keybindings.
  # CTRL-R for hist search, CTRL-T to fill in file on CLI, ALT+C (actually only
  # Esc-C works) to change to a subdir.
  source <(fzf --zsh)

  export FZF_DEFAULT_COMMAND="fd --type f --hidden --exclude .git"
  function fzfd() {
    local dir
    dir=$(/usr/bin/find ${1:-.} -path '*/\.*' -prune -o -type d -print 2> /dev/null | fzf +m) && cd "$dir"
  }
fi

export RIPGREP_CONFIG_PATH="$HOME/prog/dotfiles/ripgreprc"
